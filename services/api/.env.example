# Copy this file to .env and fill in real secrets. Never commit the real .env file.

# ---- Server ----
NODE_ENV=development
PORT=8080
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# ---- Database ----
MONGODB_URI=

# ---- Auth / JWT ----
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ---- Email / Resend ----
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=MeiteiMart

# ---- Mobile OTP / SMS (Fast2SMS) ----
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_TEMPLATE_ID=
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ---- Vercel Blob (file storage) ----
BLOB_READ_WRITE_TOKEN=

# ---- Super Admin seed (first run only) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@meiteimart.com
SUPER_ADMIN_PHONE=+919999999999
